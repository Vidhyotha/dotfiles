// Niri config for Vidhyotha.
// Mirrors ~/.config/hypr/config/binds.lua adapted to niri's scrollable-column model.
// Theme (focus-ring/border/tab-indicator colors) is generated by Noctalia into noctalia.kdl.

include "noctalia.kdl"

input {
    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-profile "flat"
    }

    // Hyprland focuses the window under the cursor by default.
    focus-follows-mouse
    // Hyprland warps the cursor to newly focused windows.
    warp-mouse-to-focus
}

layout {
    // General gaps_in from hypr decorations.lua.
    gaps 3
    // Focus ring / border colors come from the noctalia include above.

    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
    }

    default-column-width { proportion 0.5; }
}

// DISPLAY/XWAYLAND_DISPLAY for xwayland-satellite (:0) are set in ~/.config/uwsm/env
// (this niri version has no `env` node; those values match what Hyprland would use).

// Xwayland out of the compositor (companion tool), plus the Noctalia shell.
spawn-at-startup "xwayland-satellite"
spawn-at-startup "noctalia"
spawn-sh-at-startup "xhost +SI:localuser:root"

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

window-rule {
    // Avoid WezTerm's initial configure bug.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}

window-rule {
    // Picture-in-Picture windows (mirrors hypr windowrules.lua).
    match title=r#"^([Pp]icture[-]?[Ii]n[-]?[Pp]icture).*$"#
    open-floating true
}

window-rule {
    // Wine/Proton games (.exe) float (mirrors hypr windowrules.lua).
    match app-id=r#".*\.exe$"#
    open-floating true
}

window-rule {
    // App launchers float (mirrors hypr windowrules.lua).
    match app-id=r#".*[Ll]auncher.*"#
    open-floating true
}

window-rule {
    // Calculators float (mirrors hypr windowrules.lua).
    match app-id=r#".*[Cc]alc.*"#
    open-floating true
}

window-rule {
    // Noctalia shell windows float (mirrors hypr windowrules.lua).
    match app-id=r#"^(dev\.)?noctalia\.Noctalia(\.Settings)?$"#
    open-floating true
}

window-rule {
    // GTK file picker dialogs float (mirrors hypr windowrules.lua).
    match app-id=r#"^xdg-desktop-portal-gtk$"#
    open-floating true
}

window-rule {
    // Steam auxiliary windows float (mirrors hypr windowrules.lua).
    match app-id=r#"^steam$"#
    match title=r#"^(Friends List|Launching\.\.\.)$"#
    open-floating true
}

binds {
    //---------------
    // WINDOW MGMT
    //---------------
    Super+Escape               { spawn-sh "noctalia msg panel-toggle session"; }
    Super+W                    { close-window; }
    Super+Alt+Space            { toggle-window-floating; }
    Super+D                    { fullscreen-window; }          // Hyprland fullscreen no-gaps
    Super+F                    { maximize-column; }            // Hyprland fullscreen (keeps gaps)
    Super+J                    { toggle-column-tabbed-display; } // Hyprland togglesplit (adapted)

    //--------
    // FOCUS
    //--------
    Super+Left                 { focus-column-left; }
    Super+Right                { focus-column-right; }
    Super+Up                   { focus-window-up; }
    Super+Down                 { focus-window-down; }
    Alt+Tab                    { focus-window-or-workspace-down; } // Hyprland cycle next
    Alt+Shift+Tab              { focus-window-or-workspace-up; }   // cycle previous
    Super+Tab                  { spawn-sh "noctalia msg window-switcher"; }

    //--------
    // MOVE
    //--------
    Super+Shift+Up             { move-window-up; }
    Super+Shift+Down           { move-window-down; }
    Super+Shift+Left           { consume-or-expel-window-left; }
    Super+Shift+Right          { consume-or-expel-window-right; }
    Super+Shift+Ctrl+Left      { move-window-to-workspace-up; }
    Super+Shift+Ctrl+Right     { move-window-to-workspace-down; }
    Super+Shift+Ctrl+WheelScrollUp   { move-window-to-workspace-up; }
    Super+Shift+Ctrl+WheelScrollDown { move-window-to-workspace-down; }

    // Move focused window to workspace (mirrors NUM_WPM loop).
    Super+Shift+1             { move-window-to-workspace 1; }
    Super+Shift+2             { move-window-to-workspace 2; }
    Super+Shift+3             { move-window-to-workspace 3; }
    Super+Shift+4             { move-window-to-workspace 4; }
    Super+Shift+5             { move-window-to-workspace 5; }
    Super+Shift+6             { move-window-to-workspace 6; }
    Super+Shift+7             { move-window-to-workspace 7; }
    Super+Shift+8             { move-window-to-workspace 8; }
    Super+Shift+9             { move-window-to-workspace 9; }
    Super+Shift+0             { move-window-to-workspace 10; }

    // Move whole column to workspace (per-monitor, like Hyprland "m~i").
    Super+Shift+Ctrl+1        { move-column-to-workspace 1; }
    Super+Shift+Ctrl+2        { move-column-to-workspace 2; }
    Super+Shift+Ctrl+3        { move-column-to-workspace 3; }
    Super+Shift+Ctrl+4        { move-column-to-workspace 4; }
    Super+Shift+Ctrl+5        { move-column-to-workspace 5; }
    Super+Shift+Ctrl+6        { move-column-to-workspace 6; }
    Super+Shift+Ctrl+7        { move-column-to-workspace 7; }
    Super+Shift+Ctrl+8        { move-column-to-workspace 8; }
    Super+Shift+Ctrl+9        { move-column-to-workspace 9; }
    Super+Shift+Ctrl+0        { move-column-to-workspace 10; }

    //----------
    // LAUNCHER
    //----------
    Super+Return              { spawn-sh "uwsm app -- kitty"; }
    Super+E                   { spawn-sh "uwsm app -- nautilus"; }
    Super+T                   { spawn-sh "uwsm app -- gnome-text-editor --new-window"; }
    Super+Shift+C             { spawn-sh "uwsm app -- gnome-calculator"; }
    XF86Calculator            { spawn-sh "uwsm app -- gnome-calculator"; }
    Super+Shift+Return        { spawn-sh "uwsm app -- zen-browser"; }
    Ctrl+Shift+Escape         { spawn-sh "uwsm app -- kitty -e btop"; }
    Super+Z                   { spawn-sh "noctalia msg settings-toggle"; }
    Super+X                   { spawn-sh "noctalia msg panel-toggle control-center"; }
    Super+Space               { spawn-sh "noctalia msg panel-toggle launcher"; }
    Super+Period              { spawn-sh "noctalia msg panel-toggle launcher /emo"; }
    Super+L                   { spawn-sh "noctalia msg session lock"; }
    Super+Alt+C               { spawn-sh "noctalia msg panel-toggle session"; }
    Super+K                   { spawn-sh "noctalia msg panel-toggle vidhyotha/keybind-cheatsheet:cheatsheet"; }

    //------------------
    // HARDWARE CONTROL
    //------------------
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause       allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "noctalia msg media previous"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    //-----------
    // UTILITIES
    //-----------
    Super+P                   { spawn-sh "hyprpicker -a -n"; }
    Print                     { spawn-sh "noctalia msg screenshot-region"; }
    Super+Print               { spawn-sh "noctalia msg screenshot-fullscreen"; }
    Super+Shift+W             { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Super+Shift+V             { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Super+A                   { spawn-sh "noctalia msg panel-toggle control-center notifications"; }

    // Note: Hyprland's "universal copy/paste" (Super+C/V -> Ctrl+Insert/Shift+Insert)
    // has no niri equivalent and is intentionally not bound here.

    //-----------------------
    // WORKSPACES & MONITORS
    //-----------------------
    Super+1                   { focus-workspace 1; }
    Super+2                   { focus-workspace 2; }
    Super+3                   { focus-workspace 3; }
    Super+4                   { focus-workspace 4; }
    Super+5                   { focus-workspace 5; }
    Super+6                   { focus-workspace 6; }
    Super+7                   { focus-workspace 7; }
    Super+8                   { focus-workspace 8; }
    Super+9                   { focus-workspace 9; }
    Super+0                   { focus-workspace 10; }

    // niri workspaces are per-monitor, so Hyprland's "m~i"/"m+/-1" map directly.
    Super+Ctrl+Left           { focus-workspace-up; }
    Super+Ctrl+Right          { focus-workspace-down; }

    // Scroll through existing workspaces (mirrors Hyprland mouse_up/mouse_down).
    Super+WheelScrollUp       cooldown-ms=150 { focus-workspace-down; }
    Super+WheelScrollDown     cooldown-ms=150 { focus-workspace-up; }
    Super+Ctrl+WheelScrollUp  cooldown-ms=150 { focus-workspace-up; }
    Super+Ctrl+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }

    // Note: Hyprland scratchpad (Super+S / Super+Shift+S) has no niri equivalent.
    // Note: monitor-index binds (Super+Alt+1/2/3, Super+Shift+Alt+1/2/3) are left out
    // because MONITOR1/2/3 are effectively unset in this single-monitor setup.

    //-------------------
    // BLUETOOTH RECOVERY
    //-------------------
    Super+B                   { spawn-sh "nohup sh -c 'sleep 3 && systemctl --user restart wireplumber' >/dev/null 2>&1 &"; }

    //------------
    // NIRI EXTRAS
    //------------
    Super+Shift+Slash         { show-hotkey-overlay; }
    Super+O repeat=false      { toggle-overview; }
    Super+R                   { switch-preset-column-width; }
    Super+Shift+R             { switch-preset-column-width-back; }
    Super+M                   { maximize-window-to-edges; }
    Super+Shift+E             { quit; }
}