#!/usr/bin/env python3
"""Watch the ACPI platform profile and reapply the panel refresh rate.

The kernel driver notifies on every write to platform_profile (inotify
supported), so no polling is needed. Unlike a systemd path unit this stays
reliably attached across events. Also applies once at startup.

Run as a systemd user service: hypr-refresh-watch.service
"""

import ctypes
import ctypes.util
import os
import select
import subprocess
import sys
import time

PROFILE = b"/sys/firmware/acpi/platform_profile"
IN_MODIFY = 0x2
SCRIPT = os.path.expanduser("~/.local/bin/hypr-refresh-rate")

libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)


def apply_now() -> None:
    subprocess.run([SCRIPT], check=False)


def main() -> int:
    apply_now()
    fd = libc.inotify_init()
    while fd < 0:
        time.sleep(2)
        fd = libc.inotify_init()

    wd = libc.inotify_add_watch(fd, PROFILE, IN_MODIFY)
    while wd < 0:
        sys.stderr.write(f"inotify_add_watch({PROFILE!r}) failed errno={ctypes.get_errno()}; retrying\n")
        time.sleep(2)
        wd = libc.inotify_add_watch(fd, PROFILE, IN_MODIFY)

    while True:
        ready, _, _ = select.select([fd], [], [], 30)
        if not ready:
            continue
        os.read(fd, 4096)
        apply_now()


if __name__ == "__main__":
    sys.exit(main())